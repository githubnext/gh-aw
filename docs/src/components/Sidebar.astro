---
/**
 * Overrides Starlight's Sidebar. Below 50rem the sidebar is the mobile menu
 * sheet, so it leads with the primary site links and a section heading, then
 * Starlight's own tree and MobileMenuFooter. Above 50rem only the tree shows.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import MobileNav from './MobileNav.astro';
import { getSection } from './site-nav';

const section = getSection(Astro.locals.starlightRoute.id);
const heading = section === 'blog' ? 'Blog posts' : 'Documentation';

// Expand section catalogs on their pages; keep short previews elsewhere.
Astro.locals.starlightRoute.sidebar = Astro.locals.starlightRoute.sidebar.map((entry) => {
	if (entry.type !== 'group') return entry;
	if (entry.label === 'Guides' || entry.label === 'Design Patterns' || entry.label === 'Reference') {
		const directory = entry.label === 'Guides' ? 'guides'
			: entry.label === 'Design Patterns' ? 'patterns' : 'reference';
		const id = Astro.locals.starlightRoute.id;
		const isInSection = id === directory || id.startsWith(`${directory}/`) ||
			entry.entries.some((item) => item.type === 'link' && item.isCurrent);
		if (isInSection) return { ...entry, collapsed: false };
		if (entry.label === 'Reference') {
			const preview = ['FAQ', 'AI Engines', 'Cost Management', 'Safe Outputs', 'Workflows'].map((label) => {
				const item = entry.entries.find((item) => item.label === label);
				if (!item || item.type !== 'link') throw new Error(`Missing Reference sidebar link: ${label}`);
				return item;
			});
			return {
				...entry,
				entries: [...preview, ...preview.slice(-1).map((item) => ({ ...item, label: 'More...' }))],
			};
		}
		return {
			...entry,
			entries: entry.entries.slice(0, 3).map((item, index) => index === 2 && item.type === 'link'
				? { ...item, label: 'More...' }
				: item),
		};
	}
	if (entry.label !== 'Gallery') return entry;
	return {
		...entry,
		entries: section === 'gallery'
			? entry.entries.map((item) => item.type === 'link' && item.label === 'More...'
				? { ...item, label: 'All workflows' }
				: item)
			: entry.entries.filter((item) => item.type === 'link' &&
				('data-gallery-preview' in item.attrs || item.label === 'More...')),
	};
});
---

<div class="mobile-menu-top">
	<MobileNav />
	<h2 class="mobile-menu-heading">{heading}</h2>
</div>
<Default />

<script>
	// Desktop: Starlight restores the sidebar's saved scroll position when you
	// navigate within it, but a fresh load of a deep page leaves the current
	// item far below the fold. If it's out of view, centre it in the pane.
	const scrollCurrentIntoView = () => {
		if (!matchMedia('(min-width: 50rem)').matches) return;
		const pane = document.getElementById('starlight__sidebar');
		const current = pane?.querySelector<HTMLElement>('.top-level a[aria-current="page"]');
		if (!pane || !current) return;
		const paneBox = pane.getBoundingClientRect();
		const box = current.getBoundingClientRect();
		if (box.top >= paneBox.top && box.bottom <= paneBox.bottom) return;
		pane.scrollTop += box.top - paneBox.top - (paneBox.height - box.height) / 2;
	};
	scrollCurrentIntoView();
	document.addEventListener('astro:page-load', scrollCurrentIntoView);
</script>

<style>
	.mobile-menu-top {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.mobile-menu-heading {
		margin: 0;
		padding-top: 1rem;
		border-top: 1px solid var(--aw-color-divider);
		font-size: var(--aw-step--1);
		font-weight: 500;
		color: var(--aw-color-text-muted);
	}

	@media (min-width: 50rem) {
		.mobile-menu-top {
			display: none;
		}
	}
</style>

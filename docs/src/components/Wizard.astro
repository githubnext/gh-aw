---
import { wizardDataModel } from '../lib/wizard/model';

const wizardModelJson = JSON.stringify(wizardDataModel);
---

<section class="aw-wizard" data-aw-wizard>
  <div class="aw-wizard__header">
    <div>
      <p class="aw-wizard__eyebrow">Workflow prompt wizard</p>
      <h2 class="aw-wizard__title">Build an agentic workflow</h2>
      <p class="aw-wizard__intro">
        Choose what your workflow does, when it runs, and where it reports. We’ll combine your answers with any task details into a prompt you can copy.
      </p>
    </div>
    <div class="aw-wizard__status" aria-live="polite" data-wizard-step-status></div>
  </div>

  <ol class="aw-wizard__progress" aria-label="Wizard progress" data-wizard-progress></ol>

  <div class="aw-wizard__layout">
    <section class="aw-wizard__panel" aria-labelledby="wizard-step-title">
      <div class="aw-wizard__step-header">
        <p class="aw-wizard__step-kicker" data-wizard-step-kicker></p>
        <h3 id="wizard-step-title" tabindex="-1" data-wizard-step-title></h3>
        <p class="aw-wizard__step-description" data-wizard-step-description></p>
      </div>

      <div class="aw-wizard__content" data-wizard-step-content></div>

      <div class="aw-wizard__nav">
        <button type="button" class="aw-wizard__button aw-wizard__button--secondary" data-wizard-back>
          Back
        </button>
        <button type="button" class="aw-wizard__button aw-wizard__button--primary" data-wizard-next>
          Next
        </button>
      </div>
    </section>

    <aside class="aw-wizard__summary" aria-labelledby="wizard-summary-title">
      <h3 id="wizard-summary-title">Current selections</h3>
      <dl class="aw-wizard__summary-list" data-wizard-summary></dl>
      <div class="aw-wizard__prompt-preview">
        <h4>Prompt scaffold preview</h4>
        <pre data-wizard-preview></pre>
      </div>
    </aside>
  </div>

  <script type="module" define:vars={{ wizardModelJson }}>
    const model = JSON.parse(wizardModelJson);
    const root = document.querySelector('[data-aw-wizard]');
    if (!root) throw new Error('Wizard root not found');

    const state = {
      currentStepIndex: 0,
      goalId: model.goalCategories[0]?.id ?? '',
      triggerId: '',
      destinationId: '',
      destinationOverridden: false,
      taskDescription: '',
    };

    const stepDefinitions = [
      {
        id: 'goal',
        label: 'Goal',
        title: 'Choose a workflow goal',
        description: 'Start with the outcome you want the workflow to achieve.',
        getOptions() {
          return model.goalCategories.map((goal) => ({
            id: goal.id,
            label: goal.text.label,
            help: goal.text.help,
          }));
        },
        getValue() {
          return state.goalId;
        },
        setValue(value) {
          state.goalId = value;
          syncDerivedSelections();
        },
        canContinue() {
          return Boolean(state.goalId);
        },
      },
      {
        id: 'trigger',
        label: 'When',
        title: 'Choose a trigger',
        description: 'Choose the event or schedule that should start the workflow.',
        getOptions() {
          const goal = getSelectedGoal();
          if (!goal) return [];
          return goal.triggerOptionIds
            .map((id) => model.triggerOptions.find((trigger) => trigger.id === id))
            .filter((trigger) => trigger)
            .map((trigger) => ({
              id: trigger.id,
              label: trigger.text.label,
              help: trigger.text.help ?? `Trigger type: ${trigger.type}`,
            }));
        },
        getValue() {
          return state.triggerId;
        },
        setValue(value) {
          state.triggerId = value;
          state.destinationOverridden = false;
          syncDestinationSelection();
        },
        canContinue() {
          return Boolean(state.triggerId);
        },
      },
      {
        id: 'destination',
        label: 'Where',
        title: 'Review the inferred output destination',
        description: getDestinationStepDescription(),
        getOptions() {
          const goal = getSelectedGoal();
          if (!goal) return [];
          const inferredId = getInferredDestinationId();
          return goal.destinationOptionIds
            .map((id) => model.destinationOptions.find((destination) => destination.id === id))
            .filter((destination) => destination)
            .map((destination) => ({
              id: destination.id,
              label: destination.text.label,
              help: buildDestinationOptionHelp(destination, inferredId),
            }));
        },
        getValue() {
          return state.destinationId;
        },
        setValue(value) {
          const inferredId = getInferredDestinationId();
          state.destinationId = value;
          state.destinationOverridden = value !== inferredId;
        },
        canContinue() {
          return Boolean(state.destinationId);
        },
      },
      {
        id: 'task-details',
        label: 'Task',
        title: 'Describe the task in your own words',
        description: 'Add context, constraints, or edge cases the workflow should account for.',
        getOptions() {
          return [];
        },
        getValue() {
          return state.taskDescription;
        },
        setValue(value) {
          state.taskDescription = value;
        },
        canContinue() {
          return true;
        },
        renderContent() {
          return renderTaskDescriptionField();
        },
      },
      {
        id: 'prompt',
        label: 'Prompt',
        title: 'Copy your generated prompt',
        description: 'This self-contained prompt combines every structured answer with your task description. Copy it into an AI coding assistant to generate the workflow.',
        getOptions() {
          return [];
        },
        getValue() {
          return 'generated';
        },
        setValue() {},
        canContinue() {
          return true;
        },
        renderContent() {
          return renderFinalPromptView();
        },
      },
    ];

    function getInferredDestinationId() {
      const goal = getSelectedGoal();
      const trigger = getSelectedTrigger();
      if (!goal) return null;
      const allowedDestinations = goal.destinationOptionIds
        .map((id) => model.destinationOptions.find((destination) => destination.id === id))
        .filter((destination) => destination);
      const inferred = trigger
        ? allowedDestinations.find((destination) => destination.inferFromTriggerTypes?.includes(trigger.type))
        : null;
      return inferred?.id ?? goal.defaultDestinationOptionId ?? goal.destinationOptionIds[0] ?? null;
    }

    function getDestinationStepDescription() {
      const trigger = getSelectedTrigger();
      const inferredId = getInferredDestinationId();
      const inferred = inferredId ? model.destinationOptions.find((destination) => destination.id === inferredId) : null;
      if (!inferred) {
        return 'The shell preselects a destination from the model based on the selected goal and trigger type, while still allowing review.';
      }
      const reason = trigger
        ? `because the "${trigger.text.label}" trigger commonly pairs with this output`
        : 'based on the selected goal';
      const overrideNote = state.destinationOverridden
        ? ' You have overridden this inference below — pick another option to change it again, or reselect the inferred option to restore it.'
        : ' You can override this choice below if it does not fit your workflow.';
      return `Inferred destination: "${inferred.text.label}" ${reason}.${overrideNote}`;
    }

    function buildDestinationOptionHelp(destination, inferredId) {
      const base = destination.text.help ?? `Safe output: ${destination.safeOutputType}`;
      return destination.id === inferredId ? `${base} (inferred default)` : base;
    }

    function renderTaskDescriptionField() {
      const wrapper = document.createElement('div');
      wrapper.className = 'aw-wizard__field';

      const label = document.createElement('label');
      label.className = 'aw-wizard__field-label';
      label.setAttribute('for', 'wizard-task-description');
      label.textContent = 'Task description';
      wrapper.append(label);

      const textarea = document.createElement('textarea');
      textarea.id = 'wizard-task-description';
      textarea.className = 'aw-wizard__textarea';
      textarea.rows = 6;
      textarea.placeholder = 'Describe what the workflow should do in your own words, e.g. specific tone, constraints, or edge cases to handle...';
      textarea.value = state.taskDescription;
      textarea.addEventListener('input', () => {
        state.taskDescription = textarea.value;
        updatePreview();
        updateSummary();
      });
      wrapper.append(textarea);

      return wrapper;
    }

    function renderFinalPromptView() {
      const wrapper = document.createElement('div');
      wrapper.className = 'aw-wizard__final-prompt';

      const promptText = buildPromptText();

      const pre = document.createElement('pre');
      pre.className = 'aw-wizard__final-prompt-text';
      pre.textContent = promptText;
      wrapper.append(pre);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'aw-wizard__button aw-wizard__button--secondary';
      copyButton.textContent = 'Copy prompt';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(promptText);
          copyButton.textContent = 'Copied!';
        } catch {
          copyButton.textContent = 'Copy failed — select the text manually';
        }
        setTimeout(() => {
          copyButton.textContent = 'Copy prompt';
        }, 2000);
      });
      wrapper.append(copyButton);

      return wrapper;
    }

    const progress = root.querySelector('[data-wizard-progress]');
    const stepStatus = root.querySelector('[data-wizard-step-status]');
    const stepKicker = root.querySelector('[data-wizard-step-kicker]');
    const stepTitle = root.querySelector('[data-wizard-step-title]');
    const stepDescription = root.querySelector('[data-wizard-step-description]');
    const stepContent = root.querySelector('[data-wizard-step-content]');
    const summary = root.querySelector('[data-wizard-summary]');
    const preview = root.querySelector('[data-wizard-preview]');
    const backButton = root.querySelector('[data-wizard-back]');
    const nextButton = root.querySelector('[data-wizard-next]');

    if (!(progress instanceof HTMLElement) || !(stepStatus instanceof HTMLElement) || !(stepKicker instanceof HTMLElement) || !(stepTitle instanceof HTMLElement) || !(stepDescription instanceof HTMLElement) || !(stepContent instanceof HTMLElement) || !(summary instanceof HTMLElement) || !(preview instanceof HTMLElement) || !(backButton instanceof HTMLButtonElement) || !(nextButton instanceof HTMLButtonElement)) {
      throw new Error('Wizard UI elements are missing');
    }

    function getSelectedGoal() {
      return model.goalCategories.find((goal) => goal.id === state.goalId) ?? null;
    }

    function getSelectedTrigger() {
      return model.triggerOptions.find((trigger) => trigger.id === state.triggerId) ?? null;
    }

    function getSelectedDestination() {
      return model.destinationOptions.find((destination) => destination.id === state.destinationId) ?? null;
    }

    function syncDerivedSelections() {
      const goal = getSelectedGoal();
      if (!goal) return;
      const allowedTriggers = new Set(goal.triggerOptionIds);
      if (!allowedTriggers.has(state.triggerId)) {
        state.triggerId = goal.defaultTriggerOptionId && allowedTriggers.has(goal.defaultTriggerOptionId)
          ? goal.defaultTriggerOptionId
          : goal.triggerOptionIds[0] ?? '';
        state.destinationOverridden = false;
      }
      syncDestinationSelection();
    }

    function syncDestinationSelection() {
      const goal = getSelectedGoal();
      if (!goal) return;
      const allowedIds = new Set(goal.destinationOptionIds);
      const inferredId = getInferredDestinationId();

      if (!allowedIds.has(state.destinationId)) {
        // Selection no longer valid for this goal (e.g. goal just changed) — reset to the inferred value.
        state.destinationId = inferredId ?? goal.defaultDestinationOptionId ?? goal.destinationOptionIds[0] ?? '';
        state.destinationOverridden = false;
      } else if (!state.destinationOverridden && inferredId) {
        state.destinationId = inferredId;
      }
    }

    function renderProgress() {
      progress.replaceChildren(...stepDefinitions.map((step, index) => {
        const item = document.createElement('li');
        item.className = 'aw-wizard__progress-item';
        if (index === state.currentStepIndex) item.dataset.current = 'true';
        if (index < state.currentStepIndex) item.dataset.complete = 'true';

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'aw-wizard__progress-button';
        button.textContent = `${index + 1}. ${step.label}`;
        button.setAttribute('aria-current', index === state.currentStepIndex ? 'step' : 'false');
        button.addEventListener('click', () => {
          state.currentStepIndex = index;
          render();
        });
        item.append(button);
        return item;
      }));
    }

    function renderOptions(step) {
      const options = step.getOptions();
      const value = step.getValue();
      const fieldset = document.createElement('fieldset');
      fieldset.className = 'aw-wizard__fieldset';
      fieldset.setAttribute('aria-describedby', 'wizard-step-title');
      const legend = document.createElement('legend');
      legend.className = 'sr-only';
      legend.textContent = step.title;
      fieldset.append(legend);

      const list = document.createElement('div');
      list.className = 'aw-wizard__option-list';
      list.setAttribute('role', 'radiogroup');
      list.setAttribute('aria-label', step.title);

      options.forEach((option, optionIndex) => {
        const label = document.createElement('label');
        label.className = 'aw-wizard__option';
        if (option.id === value) label.dataset.selected = 'true';

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = `wizard-${step.id}`;
        input.value = option.id;
        input.checked = option.id === value;
        input.className = 'aw-wizard__option-input';
        input.addEventListener('change', () => {
          step.setValue(option.id);
          render();
        });
        input.addEventListener('keydown', (event) => {
          if (!(event instanceof KeyboardEvent)) return;
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowRight' && event.key !== 'ArrowUp' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          const direction = event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (optionIndex + direction + options.length) % options.length;
          const nextOption = options[nextIndex];
          if (!nextOption) return;
          step.setValue(nextOption.id);
          render();
          requestAnimationFrame(() => {
            stepContent.querySelector(`input[name="wizard-${step.id}"][value="${CSS.escape(nextOption.id)}"]`)?.focus();
          });
        });

        const copy = document.createElement('div');
        copy.className = 'aw-wizard__option-copy';
        const heading = document.createElement('span');
        heading.className = 'aw-wizard__option-label';
        heading.textContent = option.label;
        copy.append(heading);
        if (option.help) {
          const help = document.createElement('span');
          help.className = 'aw-wizard__option-help';
          help.textContent = option.help;
          copy.append(help);
        }

        label.append(input, copy);
        list.append(label);
      });

      fieldset.append(list);
      return fieldset;
    }

    function updateSummary() {
      const rows = [
        ['Goal', getSelectedGoal()?.text.label ?? 'Not selected'],
        ['Trigger', getSelectedTrigger()?.text.label ?? 'Not selected'],
        ['Destination', getSelectedDestination()?.text.label ?? 'Not selected'],
        ['Task description', state.taskDescription.trim() ? `${state.taskDescription.trim().slice(0, 80)}${state.taskDescription.trim().length > 80 ? '…' : ''}` : 'Not provided'],
        ['Model version', model.version],
      ];
      const summaryNodes = [];
      rows.forEach(([term, description]) => {
        const dt = document.createElement('dt');
        dt.textContent = term;
        const dd = document.createElement('dd');
        dd.textContent = description;
        summaryNodes.push(dt, dd);
      });
      summary.replaceChildren(...summaryNodes);
    }

    function buildPromptText() {
      const goal = getSelectedGoal();
      const trigger = getSelectedTrigger();
      const destination = getSelectedDestination();
      const intro = model.promptTemplate?.introText ?? 'Create a GitHub Agentic Workflow (gh-aw) for this repository.';
      const taskDetails = state.taskDescription.trim();
      const lines = [
        intro,
        '',
        'WHAT',
        `- Goal: ${goal?.text.label ?? '—'}`,
        `- Context: ${goal?.text.help ?? '—'}`,
        '',
        'WHEN',
        `- Trigger: ${trigger?.text.label ?? '—'}`,
        `- Trigger intent: ${trigger?.text.help ?? '—'}`,
        '',
        'WHERE',
        `- Destination: ${destination?.text.label ?? '—'}`,
        `- Output intent: ${destination?.text.help ?? destination?.safeOutputType ?? '—'}`,
        state.destinationOverridden ? '- Note: this destination was manually overridden from the inferred default.' : '- Note: this destination was inferred automatically from the goal and trigger.',
        '',
        'TASK DETAILS',
        taskDetails ? taskDetails : '(No additional task details provided.)',
      ];
      return lines.join('\n');
    }

    function updatePreview() {
      preview.textContent = buildPromptText();
    }

    function render() {
      syncDerivedSelections();
      const step = stepDefinitions[state.currentStepIndex];
      renderProgress();
      stepStatus.textContent = `Step ${state.currentStepIndex + 1} of ${stepDefinitions.length}`;
      stepKicker.textContent = step.label;
      stepTitle.textContent = step.title;
      stepDescription.textContent = typeof step.description === 'function' ? step.description() : step.description;
      stepContent.replaceChildren(step.renderContent ? step.renderContent() : renderOptions(step));
      updateSummary();
      updatePreview();
      backButton.disabled = state.currentStepIndex === 0;
      nextButton.disabled = !step.canContinue();
      nextButton.textContent = state.currentStepIndex === stepDefinitions.length - 1 ? 'Review selections' : 'Next';
      stepTitle.focus();
    }

    backButton.addEventListener('click', () => {
      if (state.currentStepIndex === 0) return;
      state.currentStepIndex -= 1;
      render();
    });

    nextButton.addEventListener('click', () => {
      if (state.currentStepIndex >= stepDefinitions.length - 1) {
        summary.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      state.currentStepIndex += 1;
      render();
    });

    syncDerivedSelections();
    render();
  </script>
</section>

<style is:global>
  .aw-wizard .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .aw-wizard {
    max-width: 100%;
    margin: 1.5rem 0;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border: 1px solid var(--aw-border, var(--sl-color-hairline));
    border-radius: 6px;
    background: var(--aw-bg-subtle, var(--sl-color-bg));
  }

  .aw-wizard__header,
  .aw-wizard__layout {
    display: grid;
    gap: 1.25rem;
  }

  .aw-wizard__header {
    align-items: start;
    margin-bottom: 1rem;
  }

  .aw-wizard__eyebrow,
  .aw-wizard__step-kicker {
    margin: 0 0 0.35rem;
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .aw-wizard__title,
  .aw-wizard__summary h3,
  .aw-wizard__prompt-preview h4,
  .aw-wizard__step-header h3 {
    margin: 0;
  }

  .aw-wizard__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
  }

  .aw-wizard__intro,
  .aw-wizard__step-description {
    max-width: 68ch;
    margin: 0.5rem 0 0;
    color: var(--aw-text-muted, var(--sl-color-gray-3));
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .aw-wizard__status {
    justify-self: start;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--aw-border, var(--sl-color-hairline));
    border-radius: 999px;
    background: var(--aw-bg-page, var(--sl-color-bg));
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .aw-wizard__progress {
    display: grid;
    grid-template-columns: repeat(5, minmax(6.5rem, 1fr));
    gap: 0;
    overflow-x: auto;
    padding: 0;
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--aw-border, var(--sl-color-hairline));
    list-style: none;
    scrollbar-width: thin;
  }

  .aw-wizard__progress-item {
    margin: 0;
  }

  .aw-wizard__progress-button,
  .aw-wizard__button,
  .aw-wizard__option {
    font: inherit;
  }

  .aw-wizard__progress-button {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--aw-text-muted, var(--sl-color-gray-3));
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
  }

  .aw-wizard__progress-item[data-current='true'] .aw-wizard__progress-button {
    border-bottom-color: var(--sl-color-accent);
    color: var(--sl-color-text);
  }

  .aw-wizard__progress-item[data-complete='true'] .aw-wizard__progress-button {
    color: var(--sl-color-text);
  }

  .aw-wizard__panel,
  .aw-wizard__summary {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--aw-border, var(--sl-color-hairline));
    border-radius: 6px;
    background: var(--aw-bg-page, var(--sl-color-bg));
  }

  .aw-wizard__step-header h3 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .aw-wizard__summary h3 {
    font-size: 1.125rem;
  }

  .aw-wizard__content {
    margin-top: 0.875rem;
  }

  .aw-wizard__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .aw-wizard__option-list {
    display: grid;
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--aw-border, var(--sl-color-hairline));
    border-radius: 6px;
  }

  .aw-wizard__option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    min-width: 0;
    margin: 0;
    padding: 0.75rem;
    border-bottom: 1px solid var(--aw-border, var(--sl-color-hairline));
    background: transparent;
    cursor: pointer;
  }

  .aw-wizard__option:last-child {
    border-bottom: 0;
  }

  .aw-wizard__option:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
  }

  .aw-wizard__option[data-selected='true'] {
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    box-shadow: inset 3px 0 var(--sl-color-accent);
  }

  .aw-wizard__option-input {
    width: 1rem;
    height: 1rem;
    margin: 0.15rem 0 0;
    accent-color: var(--sl-color-accent);
  }

  .aw-wizard__option-copy {
    display: grid;
    min-width: 0;
    gap: 0.15rem;
  }

  .aw-wizard__option-label {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .aw-wizard__option-help {
    color: var(--aw-text-muted, var(--sl-color-gray-3));
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .aw-wizard__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--aw-border, var(--sl-color-hairline));
  }

  .aw-wizard__button {
    min-width: 6rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--aw-border-strong, var(--sl-color-hairline));
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .aw-wizard__button--primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border-color: var(--sl-color-accent);
  }

  .aw-wizard__button--secondary {
    background: var(--aw-bg-subtle, var(--sl-color-bg));
    color: var(--sl-color-text);
  }

  .aw-wizard__progress-button:hover,
  .aw-wizard__button:hover:not(:disabled) {
    filter: brightness(0.94);
  }

  .aw-wizard__progress-button:focus-visible,
  .aw-wizard__button:focus-visible,
  .aw-wizard__option:has(input:focus-visible),
  .aw-wizard__textarea:focus-visible {
    outline: 2px solid var(--sl-color-accent);

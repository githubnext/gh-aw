---
/** Hero D: category-led. "Continuous AI for every repository." with CI / CD / Continuous AI lanes. */
import CtaRow from './CtaRow.astro';
import HeroVDVisual from './HeroVDVisual.astro';
---

<div class="aw-hero-inner">
  <div class="aw-hero-text">
    <h1 data-slideshow-entrance="rise"><span class="aw-line">Continuous AI</span> <span class="aw-line">for every repository,</span> <span class="aw-line aw-muted">always running.</span></h1>
    <p class="aw-hero-sub" data-slideshow-entrance="rise">
      A third pillar beside CI and CD: coding agents that keep improving your repository, triaging, documenting, testing and fixing in GitHub Actions, under guardrails you control.
    </p>
    <div class="aw-hero-cta" data-slideshow-hide><CtaRow /></div>
  </div>
  <div class="aw-hero-visual" data-slideshow-entrance="fade"><HeroVDVisual /></div>
</div>

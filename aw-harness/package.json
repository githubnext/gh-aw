{
  "name": "@github/aw-harness",
  "version": "0.1.0",
  "private": true,
  "description": "EXPERIMENTAL: Pi SDK-based execution engine for engine: aw workflows",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "node --experimental-strip-types build.ts",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.72.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "3.1.3",
    "esbuild": "0.25.4",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
